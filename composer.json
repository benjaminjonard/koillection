{
    "name": "benjaminjonard/koillection",
    "description": "Koillection is a self-hosted service allowing users to manage any kind of collection.",
    "type": "project",
    "license": "MIT",
    "version": "1.8.5",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "api-platform/core": "5.0.5",
        "chrome-php/chrome": "^1.16",
        "composer/semver": "3.6.0",
        "doctrine/dbal": "4.5.0",
        "doctrine/doctrine-bundle": "3.3.4",
        "doctrine/doctrine-migrations-bundle": "4.0.1",
        "doctrine/orm": "3.7.6",
        "doctrine/persistence": "4.2.1",
        "lexik/jwt-authentication-bundle": "3.2.0",
        "maennchen/zipstream-php": "3.2.2",
        "mtdowling/jmespath.php": "2.9.2",
        "nelmio/cors-bundle": "2.6.1",
        "symfony/asset": "8.1.0",
        "symfony/browser-kit": "v8.1.11",
        "symfony/cache": "8.1.11",
        "symfony/console": "8.1.11",
        "symfony/css-selector": "8.1.10",
        "symfony/dependency-injection": "8.1.11",
        "symfony/dom-crawler": "8.1.10",
        "symfony/dotenv": "8.1.6",
        "symfony/error-handler": "8.1.10",
        "symfony/event-dispatcher": "8.1.5",
        "symfony/expression-language": "8.1.9",
        "symfony/finder": "8.1.11",
        "symfony/flex": "2.12.0",
        "symfony/form": "8.1.11",
        "symfony/framework-bundle": "8.1.11",
        "symfony/http-client": "8.1.11",
        "symfony/http-foundation": "8.1.11",
        "symfony/http-kernel": "8.1.11",
        "symfony/intl": "8.1.10",
        "symfony/mime": "8.1.10",
        "symfony/monolog-bundle": "4.1.0",
        "symfony/process": "8.1.10",
        "symfony/property-access": "8.1.11",
        "symfony/property-info": "8.1.11",
        "symfony/reprise": "1.3.0",
        "symfony/routing": "8.1.11",
        "symfony/runtime": "8.1.11",
        "symfony/security-bundle": "8.1.11",
        "symfony/security-core": "8.1.11",
        "symfony/security-http": "8.1.11",
        "symfony/serializer": "8.1.11",
        "symfony/string": "8.1.10",
        "symfony/translation": "8.1.11",
        "symfony/twig-bridge": "8.1.10",
        "symfony/twig-bundle": "8.1.9",
        "symfony/uid": "8.1.9",
        "symfony/validator": "8.1.11",
        "symfony/web-link": "8.1.0",
        "symfony/yaml": "8.1.11",
        "twig/extra-bundle": "3.29.0",
        "twig/intl-extra": "3.30.0",
        "twig/string-extra": "3.24.0",
        "twig/twig": "3.30.0"
    },
    "require-dev": {
        "brianium/paratest": "7.27.5",
        "dama/doctrine-test-bundle": "8.7.0",
        "friendsofphp/php-cs-fixer": "3.95.27",
        "igor-php/igor-php": "^0.10.1",
        "justinrainbow/json-schema": "6.14.0",
        "phpunit/php-code-coverage": "14.5.1",
        "phpunit/phpunit": "13.4.6",
        "rector/rector": "2.8.4",
        "symfony/maker-bundle": "1.67.0",
        "symfony/stopwatch": "8.1.0",
        "symfony/var-dumper": "8.1.10",
        "symfony/web-profiler-bundle": "8.1.11",
        "zenstruck/foundry": "2.15.0"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Api\\": "api/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "Composer\\Config::disableProcessTimeout",
            "./vendor/phpunit/phpunit/phpunit --color=always --coverage-html=\"output/code-coverage\""
        ],
        "test:phpunit": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/phpunit/phpunit/phpunit --display-deprecations"
        ],
        "test:paratest": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/paratest --runner=WrapperRunner"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "docker": false,
            "require": "8.1.*"
        },
        "runtime": {
            "dotenv_overload": true
        }
    }
}
