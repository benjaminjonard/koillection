{% extends 'layout.html.twig' %}

{% set breadcrumb = buildBreadcrumb([{'route': 'app_import_index', 'trans': 'menu.imports'}]) %}

{% block title %}
    {{ renderTitle(breadcrumb) }}
{% endblock %}

{% block breadcrumb %}
    {{ renderBreadcrumb(breadcrumb) }}
{% endblock %}

{% block content %}
    <div class="title-block">
        <h1>{{ 'menu.imports'|trans }}</h1>
    </div>

    <div class="content-block">
        <table class="striped">
            <thead>
                <tr>
                    <th>{{ 'label.date'|trans }}</th>
                    <th>{{ 'label.collection'|trans }}</th>
                    <th>{{ 'label.file'|trans }}</th>
                    <th>{{ 'label.status'|trans }}</th>
                    <th>{{ 'label.progress'|trans }}</th>
                    <th>{{ 'label.imported_items'|trans }}</th>
                    <th>{{ 'label.error'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for import in imports %}
                    <tr class="list-element resize-element">
                        <td>{{ import.createdAt|date(app.user.dateFormat|default('Y-m-d') ~ ' H:i', app.user.timezone|default('UTC')) }}</td>
                        <td>
                            <a href="{{ path('app_collection_show', {'id': import.collection.id}) }}">{{ import.collection.title }}</a>
                        </td>
                        <td>{{ import.filename }}</td>
                        <td>{{ ('global.import_statuses.' ~ import.status)|trans }}</td>
                        <td>{{ import.processedRows }}/{{ import.totalRows }}</td>
                        <td>{{ import.importedItems }}</td>
                        <td>
                            {% for error in import.errors %}
                                <div>{{ 'label.line'|trans }} {{ error.lines|join(', ') }} : {{ error.message }}</div>
                            {% endfor %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
